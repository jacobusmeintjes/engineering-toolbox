{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSubnetsAndVpcs",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::014858193168-observability",
      "Condition": {
        "StringLike": {
          "s3:prefix": "signoz/*"
        }
      }
    },
    {
      "Sid": "ReadWriteStateAndLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::014858193168-observability/signoz/*"
    }
  ]
}
